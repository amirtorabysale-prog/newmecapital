# ---------- Required ----------
# توکن بات را از @BotFather بگیرید
BOT_TOKEN=123456789:AA...your...token...here

# ---------- Optional ----------
# آی‌دی چتی که الارم‌ها به آن ارسال شوند (اگر خالی باشد، با اولین /start ثبت می‌شود)
# برای گرفتن آی‌دی خودتان به @userinfobot پیام دهید
ALERT_CHAT_ID=

# آی‌دی ادمین‌ها جدا شده با کاما (خالی = همه دستورات در دسترس هستند)
ADMIN_IDS=

# فاصله‌ی پیش‌فرض رصد (دقیقه) — بعداً با /interval قابل تغییر
CHECK_INTERVAL_MIN=60

# تایم‌فریم پیش‌فرض رصد: minute1/minute5/minute15/minute30/hour1/hour4/hour8/day1/week1
TIMEFRAME=day1

# تعداد کندلی که برای تحلیل گرفته می‌شود
KLINE_LIMIT=200

# فاصله‌ی مجاز تکرار یک سیگنال برای یک ارز (ساعت)
COOLDOWN_HOURS=12

# نمایش زمان‌ها
TIMEZONE=Asia/Tehran

# حداکثر تعداد ارز در واچ‌لیست
MAX_WATCHLIST=30
