{
  "watchlist": [
    { "id": "BTCUSD", "base": "BTC" },
    { "id": "XAUUSD", "base": "XAU", "lbank": "xaut_usdt", "binance": "PAXGUSDT", "binanceFutures": "XAUUSDT" },
    { "id": "SOLUSDT", "base": "SOL" },
    { "id": "AVAXUSDT", "base": "AVAX" },
    { "id": "AAVEUSDT", "base": "AAVE" },
    { "id": "HYPEUSDT", "base": "HYPE" },
    { "id": "NEARUSDT", "base": "NEAR" },
    { "id": "MAGMAUSDT", "base": "MAGMA" }
  ],

  "exchanges": ["lbank", "binance", "mexc", "gate", "bitget", "binanceFutures"],
  "timeframe": "1h",
  "candles": 400,
  "scanEvery": "4h",

  "alertThreshold": 70,
  "directions": ["long"],
  "cooldownHours": 12,
  "alertTtlHours": 3,
  "publishMaxDriftAtr": 0.5,
  "nearAlerts": true,
  "maxHoldHours": 120,

  "strategy": {
    "atrPeriod": 14,
    "rsiPeriod": 14,

    "conditions": {
      "trendline":   { "enabled": true,  "weight": 30, "required": true },
      "fib":         { "enabled": true,  "weight": 25, "required": false },
      "divergence":  { "enabled": true,  "weight": 25, "required": false },
      "divergence5m": { "enabled": true, "weight": 15, "required": false },
      "candle":      { "enabled": true,  "weight": 20, "required": false },
      "trendFilter": { "enabled": false, "weight": 15, "required": true },
      "volume":      { "enabled": false, "weight": 10, "required": false }
    },

    "trendline": {
      "lookback": 250,
      "pivotStrength": 6,
      "minSpacing": 12,
      "minBounceAtr": 2.0,
      "touchToleranceAtr": 0.5,
      "approachAtr": 1.5,
      "breakToleranceAtr": 0.25,
      "maxWickPierceAtr": 0.6,
      "touchWindow": 3
    },

    "fib": {
      "level": 0.618,
      "toleranceAtr": 0.6,
      "nearToleranceAtr": 1.2
    },

    "rsiZone": {
      "enabled": true,
      "low": 30,
      "high": 80
    },

    "divergence": {
      "pivotStrength": 3,
      "lookback": 60,
      "minGap": 8,
      "minRsiDelta": 3.0,
      "allowHidden": true
    },

    "divergence5m": {
      "pivotStrength": 3,
      "lookback": 72,
      "minGap": 6,
      "minRsiDelta": 3.0,
      "allowHidden": true
    },

    "candles": {
      "window": 2
    },

    "trendFilter": {
      "emaPeriod": 200
    },

    "volume": {
      "period": 20,
      "multiplier": 1.3
    },

    "plan": {
      "slBufferAtr": 0.5,
      "tpExtensions": [0, 0.272, 0.618],
      "minRR": 1.0
    }
  },

  "chart": {
    "minBars": 70,
    "watermark": ""
  }
}
